# Copy to backend/.env and fill in. .env is git-ignored.

DB_HOST=golang-postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=sat04db
JWT_SECRET=replace_with_a_strong_secret
JWT_EXPIRES_IN=24h
SERVER_PORT=8080

# Comma-separated origins allowed to call the API (frontend dev servers).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Optional. Enables the "scan class schedule" button on the student profile
# (POST /student/schedule/extract, Google Gemini Vision). Without it the app
# works fully — students just type their free time in manually.
GEMINI_API_KEY=
# Optional. Override the Gemini model (default: gemini-3.6-flash) if Google
# retires that name. e.g. GEMINI_MODEL=gemini-3.6-flash
GEMINI_MODEL=
